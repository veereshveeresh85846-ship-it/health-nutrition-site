{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated portal user profile with strict role separation and PII isolation.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 160
        },
        "role": {
          "type": "string",
          "enum": ["participant", "admin"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "displayName", "email", "role", "createdAt", "updatedAt"]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Trusted role document identifying authorized program administrators.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 160
        },
        "grantedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "grantedAt"]
    },
    "Participant": {
      "title": "Participant",
      "description": "Registered program participant linked by unique Participant ID for matched pre/post awareness evaluation.",
      "type": "object",
      "properties": {
        "participantId": {
          "type": "string",
          "minLength": 10,
          "maxLength": 32,
          "pattern": "^HN-[0-9]{4}-[A-Z0-9]{4,8}$"
        },
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ageGroup": {
          "type": "string",
          "enum": ["Under 18", "18-24", "25-34", "35-49", "50+"]
        },
        "gender": {
          "type": "string",
          "enum": ["Prefer not to say", "Female", "Male", "Non-binary"]
        },
        "educationLevel": {
          "type": "string",
          "enum": ["High School", "Undergraduate (VTU / College)", "Postgraduate", "Working Professional", "Other"]
        },
        "foodHabits": {
          "type": "string",
          "enum": ["Vegetarian", "Eggetarian", "Non-Vegetarian", "Vegan"]
        },
        "preSurveyCompleted": {
          "type": "boolean"
        },
        "postSurveyCompleted": {
          "type": "boolean"
        },
        "preScore": {
          "type": "number"
        },
        "postScore": {
          "type": "number"
        },
        "learningModulesCompleted": {
          "type": "array"
        },
        "consentGiven": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "participantId",
        "ownerUid",
        "ageGroup",
        "gender",
        "educationLevel",
        "foodHabits",
        "preSurveyCompleted",
        "postSurveyCompleted",
        "preScore",
        "postScore",
        "learningModulesCompleted",
        "consentGiven",
        "createdAt",
        "updatedAt"
      ]
    },
    "PreSurvey": {
      "title": "PreSurvey",
      "description": "Baseline awareness survey record keyed by unique Participant ID to prevent duplicates.",
      "type": "object",
      "properties": {
        "participantId": {
          "type": "string",
          "minLength": 10,
          "maxLength": 32,
          "pattern": "^HN-[0-9]{4}-[A-Z0-9]{4,8}$"
        },
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "surveyType": {
          "type": "string",
          "enum": ["PRE-SURVEY"]
        },
        "responses": {
          "type": "array"
        },
        "correctCount": {
          "type": "number"
        },
        "totalQuestions": {
          "type": "number"
        },
        "percentage": {
          "type": "number"
        },
        "adoptedHabits": {
          "type": "array"
        },
        "consentGiven": {
          "type": "boolean"
        },
        "submissionDate": {
          "type": "string",
          "maxLength": 16,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "participantId",
        "ownerUid",
        "surveyType",
        "responses",
        "correctCount",
        "totalQuestions",
        "percentage",
        "adoptedHabits",
        "consentGiven",
        "submissionDate",
        "createdAt"
      ]
    },
    "PostSurvey": {
      "title": "PostSurvey",
      "description": "Post-program awareness survey record matched by unique Participant ID.",
      "type": "object",
      "properties": {
        "participantId": {
          "type": "string",
          "minLength": 10,
          "maxLength": 32,
          "pattern": "^HN-[0-9]{4}-[A-Z0-9]{4,8}$"
        },
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "surveyType": {
          "type": "string",
          "enum": ["POST-SURVEY"]
        },
        "responses": {
          "type": "array"
        },
        "correctCount": {
          "type": "number"
        },
        "totalQuestions": {
          "type": "number"
        },
        "percentage": {
          "type": "number"
        },
        "adoptedHabits": {
          "type": "array"
        },
        "learningFeedback": {
          "type": "string",
          "maxLength": 1000
        },
        "rating": {
          "type": "number"
        },
        "consentGiven": {
          "type": "boolean"
        },
        "submissionDate": {
          "type": "string",
          "maxLength": 16,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "participantId",
        "ownerUid",
        "surveyType",
        "responses",
        "correctCount",
        "totalQuestions",
        "percentage",
        "adoptedHabits",
        "learningFeedback",
        "rating",
        "consentGiven",
        "submissionDate",
        "createdAt"
      ]
    },
    "PublicSurveyMetric": {
      "title": "PublicSurveyMetric",
      "description": "Anonymized non-PII survey score record written atomically with pre/post surveys for public Chart.js analytics.",
      "type": "object",
      "properties": {
        "participantId": {
          "type": "string",
          "minLength": 10,
          "maxLength": 32,
          "pattern": "^HN-[0-9]{4}-[A-Z0-9]{4,8}$"
        },
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "surveyType": {
          "type": "string",
          "enum": ["PRE-SURVEY", "POST-SURVEY"]
        },
        "responses": {
          "type": "array"
        },
        "correctCount": {
          "type": "number"
        },
        "totalQuestions": {
          "type": "number"
        },
        "percentage": {
          "type": "number"
        },
        "adoptedHabits": {
          "type": "array"
        },
        "submissionDate": {
          "type": "string",
          "maxLength": 16,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "isPublicMetric": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "participantId",
        "ownerUid",
        "surveyType",
        "responses",
        "correctCount",
        "totalQuestions",
        "percentage",
        "adoptedHabits",
        "submissionDate",
        "isPublicMetric",
        "createdAt"
      ]
    },
    "QuizResult": {
      "title": "QuizResult",
      "description": "15-question nutrition quiz attempt record.",
      "type": "object",
      "properties": {
        "resultId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "participantId": {
          "type": "string",
          "maxLength": 32
        },
        "correctCount": {
          "type": "number"
        },
        "incorrectCount": {
          "type": "number"
        },
        "totalQuestions": {
          "type": "number"
        },
        "percentage": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "resultId",
        "ownerUid",
        "participantId",
        "correctCount",
        "incorrectCount",
        "totalQuestions",
        "percentage",
        "createdAt"
      ]
    },
    "FeedbackSubmission": {
      "title": "FeedbackSubmission",
      "description": "User contact or program feedback submission with isolated PII.",
      "type": "object",
      "properties": {
        "feedbackId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "maxLength": 160
        },
        "category": {
          "type": "string",
          "enum": ["General Feedback", "Program Experience", "Suggestion", "Technical Inquiry"]
        },
        "message": {
          "type": "string",
          "minLength": 5,
          "maxLength": 1500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["feedbackId", "ownerUid", "name", "email", "category", "message", "createdAt"]
    },
    "PublicTestimonial": {
      "title": "PublicTestimonial",
      "description": "Admin-approved sanitized participant testimonial displayed on the Home page without PII.",
      "type": "object",
      "properties": {
        "testimonialId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "authorName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "roleLabel": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "quote": {
          "type": "string",
          "minLength": 10,
          "maxLength": 500
        },
        "improvementSummary": {
          "type": "string",
          "maxLength": 120
        },
        "isPublished": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["testimonialId", "authorName", "roleLabel", "quote", "improvementSummary", "isPublished", "createdAt"]
    },
    "EducationalContent": {
      "title": "EducationalContent",
      "description": "Admin-managed health and nutrition educational article.",
      "type": "object",
      "properties": {
        "contentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "topic": {
          "type": "string",
          "enum": ["Balanced Diet", "Macronutrients", "Micronutrients", "Healthy Habits", "Personal Hygiene", "Healthy Lifestyle"]
        },
        "title": {
          "type": "string",
          "minLength": 3,
          "maxLength": 140
        },
        "summary": {
          "type": "string",
          "minLength": 10,
          "maxLength": 400
        },
        "body": {
          "type": "string",
          "minLength": 20,
          "maxLength": 5000
        },
        "keyPoints": {
          "type": "array"
        },
        "readTimeMinutes": {
          "type": "number"
        },
        "isPublished": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["contentId", "topic", "title", "summary", "body", "keyPoints", "readTimeMinutes", "isPublished", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private user account profile containing email PII, accessible only to owner or admin."
    },
    "/admins/{userId}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Role-based access control lookup documents for program administrators."
    },
    "/participants/{participantId}": {
      "schema": { "$ref": "#/entities/Participant" },
      "description": "Participant demographic and completion progress records keyed by unique Participant ID."
    },
    "/pre_surveys/{participantId}": {
      "schema": { "$ref": "#/entities/PreSurvey" },
      "description": "Baseline pre-program survey responses keyed by unique Participant ID to prevent duplicate submissions."
    },
    "/post_surveys/{participantId}": {
      "schema": { "$ref": "#/entities/PostSurvey" },
      "description": "Post-program survey responses matched by unique Participant ID."
    },
    "/public_survey_metrics/{metricId}": {
      "schema": { "$ref": "#/entities/PublicSurveyMetric" },
      "description": "Anonymized zero-PII survey scores written atomically with pre/post surveys for live community analytics."
    },
    "/quiz_results/{resultId}": {
      "schema": { "$ref": "#/entities/QuizResult" },
      "description": "15-question nutrition quiz results owned by authenticated participants."
    },
    "/feedback/{feedbackId}": {
      "schema": { "$ref": "#/entities/FeedbackSubmission" },
      "description": "Contact and feedback submissions with isolated optional email PII."
    },
    "/testimonials/{testimonialId}": {
      "schema": { "$ref": "#/entities/PublicTestimonial" },
      "description": "Admin-approved sanitized participant testimonials without PII."
    },
    "/educational_content/{contentId}": {
      "schema": { "$ref": "#/entities/EducationalContent" },
      "description": "Admin-managed educational articles displayed in the Nutrition Education portal."
    }
  }
}
